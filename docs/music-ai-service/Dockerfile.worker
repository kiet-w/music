FROM python:3.12-slim

# Install system dependencies: ffmpeg for conversion, aria2 for fast downloading
RUN apt-get update && apt-get install -y \
    ffmpeg \
    aria2 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast package management
RUN pip install uv

WORKDIR /app

# Copy pyproject.toml and uv.lock
COPY pyproject.toml uv.lock ./

# Install dependencies
RUN uv sync --frozen

# Copy source code
COPY . .

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Command to run Dramatiq worker
HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
  CMD uv run dramatiq --help > /dev/null 2>&1 || exit 1

CMD ["uv", "run", "dramatiq", "app.worker", "--processes", "2", "--threads", "4"]
