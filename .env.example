# .env.example — root production environment variables
# Copy this to .env and fill in actual values before deploying.

# ── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dbuser:password@db:5432/music_db?schema=public&pgbouncer=false
DIRECT_URL=postgresql://dbuser:password@db:5432/music_db?schema=public
PORT=4000
JWT_SECRET=your_jwt_secret_change_me
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=your_32_byte_hex_encryption_key
CORS_ORIGINS=https://yourdomain.com

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/callback/google

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ── Infrastructure ───────────────────────────────────────────────────────────
# Domain name for Caddy (auto-obtains Let's Encrypt TLS)
DOMAIN=yourdomain.com

# ── Sentry Error Tracking (create projects at https://sentry.io) ─────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# ── Monitoring (Grafana) ─────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_in_production

# ── Database Backup ──────────────────────────────────────────────────────────
# Extract these from DATABASE_URL above
DB_HOST=db
DB_NAME=music_db
DB_USER=dbuser
DB_PASSWORD=password
