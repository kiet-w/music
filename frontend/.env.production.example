# Production Environment Configuration
# Copy this file to .env.production and fill in real values

# API Configuration
NEXT_PUBLIC_API_URL=https://your-production-api-domain.com
NEXT_PUBLIC_PYTHON_API_URL=https://your-production-python-api-domain.com

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=[GOOGLE_OAUTH_CLIENT_ID]

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[SUPABASE_ANON_KEY]

# Capacitor Configuration (for APK builds)
CAPACITOR_SERVER_URL=https://your-production-domain.com
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=[SENTRY_DSN]

# Environment
NODE_ENV=production