# Production Environment Configuration Example
# Copy this file to .env.production and fill in actual values

# Server Configuration
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=production

# CORS Configuration
CORS_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

# File Storage Configuration
OUTPUT_DIR=/tmp/music_converter_downloads

# Redis Configuration (for production task storage)
# Set USE_REDIS=true in production to enable Redis-based task storage
USE_REDIS=true
REDIS_HOST=[REDIS_HOST]
REDIS_PORT=6379
REDIS_PASSWORD=[REDIS_PASSWORD]
REDIS_DB=0

# Rate Limiting
MAX_CONVERSIONS_PER_MINUTE=10
MAX_DOWNLOADS_PER_MINUTE=20

# Logging
LOG_LEVEL=WARNING