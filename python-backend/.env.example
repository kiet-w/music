# Python Backend Environment Configuration
# Copy this file to .env and fill in actual values

# Server Configuration
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3003

# File Storage Configuration
OUTPUT_DIR=/tmp/music_converter_downloads

# Redis Configuration (for production task storage)
# Set USE_REDIS=true in production to enable Redis-based task storage
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting (optional)
MAX_CONVERSIONS_PER_MINUTE=10
MAX_DOWNLOADS_PER_MINUTE=20

# Logging
LOG_LEVEL=INFO