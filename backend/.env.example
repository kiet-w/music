# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3003,https://your-domain.com

# Database Connection (Prisma & Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/music_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/music_db?schema=public"

# Security & Session
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=15m
ENCRYPTION_KEY=generate_with_node_e_crypto_randomBytes_32_toString_hex

# Google Drive API
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3003/api/auth/callback/google

# Redis & Queue (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase Storage & Database Sync
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
MAIL_FROM="Music App <your-email@gmail.com>"

# Sentry (Optional)
SENTRY_DSN=your-sentry-dsn

# Monitoring (Optional)
ENABLE_METRICS=true